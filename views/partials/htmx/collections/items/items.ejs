<%
function getColumnType(columnTypeID) {
    for (let item of listColumnsType) {
        if (item.id === columnTypeID) {
            return item;
        }
    }
}
%>

<%
const itemSearchTerm = typeof searchTerm === "string" ? searchTerm : undefined;
%>

<div id="collections-items-list-row" class="col-8 m-0 p-0 overflow-hidden h-100"
    <%- include("./update-items-list-signal.ejs", {
        baseUrl,
        itemSearchTerm,
    }) %>
>
    <div class="card h-100 border-end-0 rounded-0 overflow-hidden">
        <%- include("./items_header_bar.ejs") %>
        <div class="list-group list-group-flush overflow-auto h-100" gs-keep-scroll="items-<%= listID %>-<%= itemsPagination.currentPage %>">
            <% for (const item of items) { %>
                <button 
                    id="button-item-from-list"
                    class="item-from-list-id-<%= item.id %> list-group-item list-group-item-action"
                    GS-base-url="<%= baseUrl %>"
                >
                    <div class="d-flex flex-row align-items-center">
                      <div class="d-flex flex-fill flex-column align-items-left">
                        <div class="flex-fill three-dot-text text-start text-dark-emphasis fw-bold"><%= item.name %><% for (let customData of item.customData) { const columnType = getColumnType(customData.columnTypeID); if (columnType.onListItem === "on-title") {%><span class="text-secondary"> - <%= customData.value %></span><%break;}}%></div>
                        <div class="d-flex flex-row flex-wrap">
                          <% let customDataCount = 0; %>
                          <% for (let customData of item.customData) { %>
                            <% const columnType = getColumnType(customData.columnTypeID);
                            if (columnType.onListItem === "under-item") { %>
                              <% if (customDataCount > 0) { %>
                                <div class="text-dark-emphasis" style="margin-right: 1rem">|</div>
                              <% } %>
                              <div class="text-dark-emphasis fs-6" style="margin-right: 1rem;"><%= columnType.name %>: <span class="text-secondary"><%= customData.value %></span></div>
                              <% customDataCount += 1; %>
                            <% } %>
                          <% } %>
                        </div>
                      </div>
                      <% if (typeof item.rating === "number") { %>
                      <div class="starability-result starsSize" data-rating="<%= item.rating%>">Rated: <%= item.rating %> star<%= item.rating > 1 ? 's' : '' %></div>
                      <% } %>
                    </div>
                </button>
            <% } %>
        </div>
        <%- include("../partials/pagination_footer.ejs", {
            pagination: typeof itemsPagination === "object" ? itemsPagination : undefined,
            previousButtonID: "button-previous-list-page",
            nextButtonID: "button-next-list-page",
            currentListID: selectedID,
            previousHTMX: `
            `,
            nextHTMX: `
            `,
        }) %>
    </div>
</div>
